# Copie este arquivo para `.env` e preencha com suas próprias credenciais.
# O `.env` está no .gitignore e NUNCA deve ser versionado.
#
# Sem estas variáveis o app roda normalmente com os dados de demonstração;
# elas só são necessárias para ligar a sincronização na nuvem e as integrações.

# Supabase (sincronização na nuvem). Chave "publishable"/anon — protegida por
# Row Level Security. Pegue em: Supabase > Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Google OAuth (Calendar, Gmail somente-leitura, Drive). Client ID público,
# criado no Google Cloud Console > Credentials > OAuth Client ID (Web).
VITE_GOOGLE_CLIENT_ID=

# ID da pasta do Google Drive usada pelo módulo "Estudos Livres" (opcional).
VITE_DRIVE_STUDIES_FOLDER_ID=
